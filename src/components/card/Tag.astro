---
import { Icon } from "astro-icon/components";
interface TagList{
  label: string;
  name: string;
}
interface Props{
  tagList: TagList[]
}

const {tagList} = Astro.props as Props

---

<tag-icon>
    <div class="flex gap-2 mt-3 flex-wrap" data-aos="zoom-in">
  {tagList.map(({label,name})=>(
    <button class="flex items-center space-x-1 px-2 rounded bg-gray-200 dark:bg-white/20">
      <Icon name={name} width={15} height={15} />
      <span class="text-sm text-gray-500 dark:text-gray-300">{label}</span>
    </button>
  ))}
  </div>

  
</tag-icon>
