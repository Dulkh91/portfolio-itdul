---
import Card from "./Card.astro"
import { datasProject } from "../lip/datasProject";

const projecObj = datasProject()
---

<project-content>
  <div class="container mx-auto" >
    <div class="pt-24 space-y-13">
      <Card datas={projecObj}/>
    </div>
  </div>
</project-content>



<style>
  <project-content {
    @apply backdrop-blur-[2px];
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
  }
</style>
