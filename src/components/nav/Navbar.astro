---
import DesktopMenu from "./DesktopMenu.astro";
import MobileMenu from "./MobileMenu.astro";
import DarkMode from "./DarkMode.astro";
import Hamberger from "./Hamberger.astro";
import { Icon } from "astro-icon/components";

const textLink: { label: string; href: string }[] = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects/" },
  { label: "About", href: "/about" },
];
---

<div
  class="nav-contain fixed flex items-center w-full bg-gray-200/80 dark:bg-slate-800/80 p-2 h-14 shadow"
>
  <!-- Destop Menu -->
  <div class="hidden md:block w-full">
    <DesktopMenu textLink={textLink} />
  </div>

  <!-- Mobile navbar -->
   <div>
    <div class=" absolute top-2 right-5 md:right-20 flex justify-center items-center">
      <div class=" relative w-10 h-10 flex justify-center items-center hover:bg-violet-500/60 ">
          <DarkMode/>
      </div>
      <div class="md:hidden w-10 h-10 flex justify-center items-center">
        <Hamberger/>
      </div>
    </div>

    <!-- Home mobile -->
    <div class="md:hidden absolute top-2 left-6 md:right-20 flex justify-center items-center gap-3">
        <div class="home-icon w-10 h-10 flex justify-center items-center ">
          <a href="/">
            <Icon name={`home`} width={25} height={25} class="text-gray-500 dark:text-gray-100"/>
          </a>
      </div>
    </div>
  </div>
      
</div>
<!-- Mobile menu -->
<div class="md:hidden mobile-nav">
  <MobileMenu textLink={textLink} />
</div>

<script>
import { isOpenMenu } from "../../store";
  document.addEventListener('astro:page-load',()=>{
    const btnHome =   document.querySelector('.home-icon')

    const handler = ()=> isOpenMenu.set(false)
    btnHome?.addEventListener('click',handler)

    // Remove event click
    return () => btnHome?.removeEventListener('click', handler)

  })
</script>



<style>

  .nav-contain {
    z-index: 20;
  }
  .mobile-nav {
    z-index: 20;
  }
</style>
