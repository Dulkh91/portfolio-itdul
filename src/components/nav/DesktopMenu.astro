---
interface TextLink {
  label: string;
  href: string;
}
interface Props {
  textLink: TextLink[];
}

const currentPath = Astro.url.pathname;
const isCurrent = currentPath ? currentPath : null;
const { textLink } = Astro.props as Props;
---

<desktop-menu>
  <div class="hidden md:block w-full">
    <div>
      <ul class="md:flex justify-center space-x-3 text-2xl text-blue-500 dark:text-gray-300 ">
        {
          textLink.map(({ label, href }) => (
            <li
              class={`cursor-pointer px-1.5  ${isCurrent === href ? "active-btn-nav" : ""}`}
            >
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</desktop-menu>

<style>
   @import "../../styles/global.css";
  .active-btn-nav {
    @apply border-b-2 border-b-blue-400 dark:border-b-gray-400 px-1.5 duration-300 text-blue-400 dark:text-gray-400;
  }
</style>