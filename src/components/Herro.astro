---
import Typewriter from "astro-typewriter";
import { Image } from "astro:assets";
import { getImage } from "astro:assets";
import Social from "./Social.astro";


const optimizeImage = await getImage({ 
  src: 'https://avatars.githubusercontent.com/u/143316945?v=4',
  width: 100,
  height: 100/1.5,
  format: 'webp'
})


---

<section class="container flex items-center justify-center bg-white dark:bg-slate-900 mx-auto max-h-screen min-h-screen dark:text-white select-none ">
  <div class="w-full py-5 ">
    <div class="flex flex-col items-center md:flex-row md:justify-between gap-2 space-y-10 md:space-y-0">
      <!-- Text -->
      <div class="space-y-7 md:w-1/2 lg:w-2/3 order-2 md:order-1 w-full h-72 md:h-auto p-5">
        <h1 class=" text-4xl md:text-5xl text-center">
          Hello <span class="wave">👋</span> I'm
        </h1>
        <h1 class=" text-5xl md:text-6xl text-sky-500 text-center">
          &lt;Ros<span class="font-light text-sky-500/50">-</span>Dul/&gt;
        </h1>
        <di class="flex justify-center">
          <p class="inline-block text-center">
          <Typewriter
            messages={["Web Developer."]}
            writeSpeed={250}
            deleteSpeed={100}
            waitWritten={3000}
            waitDeleted={2000}
            class={`text-4xl md:text-5xl lg:text-6xl bg-linear-to-r from-violet-500 to-violet-300  text-transparent bg-clip-text font-bold py-24 `}
          />
          <span class="blinking-cursor inline-block"></span>
        </p>
        </di>
          
      </div>

      <!-- Image profile -->
      <div
        class="relative w-56 h-56 md:w-72 md:h-72 bg-linear-to-t  from-violet-400 to-violet-200  dark:bg-white/10 dark:bg-none rounded-full flex items-center justify-center order-1 md:order-2 fade-in-element mr-0 md:mr-16"
      >
        <Image
          src={optimizeImage.src}
          width={optimizeImage.attributes.width}
          height={optimizeImage.attributes.height}
          alt="profile"
          class="absolute rounded-full w-50 h-50 md:w-64 md:h-64 object-object"
        />
      </div>
    </div>
  </div>

    <!-- Icon -->
    <div class=" absolute mt-5 bottom-20 md:bottom-25 md:mt-20 flex justify-center w-full">
        <div class="">
          <Social/>
        </div>

    </div><!-- End Icon -->


</section>

<style>

  /* Hi animation */
  .wave {
    animation-name: wave-animation;
    animation-duration: 2.5s;
    animation-iteration-count: infinite;
    transform-origin: 70% 70%;
    display: inline-block;
  }
  @keyframes wave-animation {
    0% {
      transform: rotate(0deg);
    }
    10% {
      transform: rotate(14deg);
    }
    20% {
      transform: rotate(-8deg);
    }
    30% {
      transform: rotate(14deg);
    }
    40% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(10deg);
    }
    60% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }
  

/* Blinking cursor writing */
.blinking-cursor{
  animation: blink 1s step-end infinite;
  width: 2px; 
  height: 3em; 
  background-color: white;
  animation: blink 1s infinite; 
}
@keyframes blink {
  0% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 1; }
}
</style>
